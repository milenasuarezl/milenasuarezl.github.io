---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import profilePhoto from "../assets/images/profile.jpg";
import { siteConfig } from "../data/site";
import { jobs } from "../data/experience";

const currentJob = jobs[0];
const currentHighlights = [
  "WCAG 2.2 audits and fixes across 30+ design system components",
  "Design token workflows with Figma, Supernova, and Style Dictionary",
  "Faster, cheaper visual regression testing and CI/CD for the team",
];

const services = [
  {
    icon: "◆",
    title: "Design systems",
    text: "Components, tokens, and documentation that designers and engineers enjoy using, and that scale across products.",
  },
  {
    icon: "◎",
    title: "Accessibility",
    text: "WCAG audits, inclusive patterns, and team habits that make accessibility the default, not a final checklist.",
  },
  {
    icon: "▲",
    title: "Frontend architecture",
    text: "React and TypeScript platforms, micro frontends, and Domain-Driven Design, built to grow with the team.",
  },
];

const stats = [
  { value: "10+", label: "years building for the web" },
  { value: "30+", label: "components made accessible" },
  { value: "6", label: "industries: edtech, fintech, banking, delivery, agencies & education" },
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-info">
      <h1 id="home-title" class="sr-only">{siteConfig.name}</h1>
      <p class="hero-lead">
        I'm Milena, a software engineer based in Berlin, focused on frontend. I solve product problems
        with <strong>scalable</strong> and <strong>accessible</strong> solutions — from design systems
        to production-ready apps.
      </p>
      <p class="eyebrow">{siteConfig.role}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/experience">My experience</a>
        <a class="btn btn-ghost" href="/about">About me</a>
      </div>
    </div>
    <div class="photo-wrap">
      <Picture
        src={profilePhoto}
        formats={["avif", "webp"]}
        widths={[220, 440]}
        sizes="220px"
        alt="Portrait of Milena Suárez smiling"
        class="photo"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section current" aria-labelledby="home-current">
    <div>
      <p class="eyebrow">Currently</p>
      <h2 id="home-current">
        {currentJob.role} at <span class="company">{currentJob.company}</span>
      </h2>
      <p class="current-since">Since {currentJob.period.replace(" – Present", "")} · Berlin</p>
    </div>
    <div class="current-body">
      <p>{currentJob.summary}</p>
      <ul class="current-list">
        {currentHighlights.map((item) => <li>{item}</li>)}
      </ul>
      <a class="arrow-link" href="/experience">
        See full experience <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section" aria-labelledby="home-services">
    <div class="section-head">
      <p class="eyebrow">What I do</p>
      <h2 id="home-services">Where I can help</h2>
    </div>
    <div class="cards cards-3">
      {
        services.map((service) => (
          <article class="card">
            <span class="service-icon" aria-hidden="true">{service.icon}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="home-stats">
    <h2 id="home-stats" class="sr-only">In numbers</h2>
    <dl class="stats">
      {
        stats.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section closing" aria-labelledby="home-community">
    <h2 id="home-community" class="sr-only">Community</h2>
    <p>
      Shaped by the <strong>BogotaJS</strong> and <strong>JSConf Colombia</strong> communities. I also
      speak now and then — <a href="/speaking">see my talks</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding-top: var(--space-8);
  }

  .hero-info {
    max-width: 36rem;
  }

  @media (min-width: 48rem) {
    .hero {
      flex-direction: row;
    }
  }

  .hero .eyebrow {
    margin-top: var(--space-5);
  }

  .hero-lead {
    margin: 0;
    max-width: 52ch;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
  }

  .hero-lead strong {
    color: var(--color-text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .photo-wrap {
    flex-shrink: 0;
    width: min(13.75rem, 70vw);
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }

  .current {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .current h2 {
    margin: 0.25rem 0 0;
    font-size: var(--font-size-h2);
  }

  .company {
    color: var(--color-accent);
  }

  .current-since {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-weight: 600;
  }

  .current-body p {
    margin: 0;
    font-size: 1.1rem;
  }

  .current-list {
    margin: var(--space-4) 0 0;
    padding-left: 1.2rem;
    color: var(--color-muted);
  }

  .current-list li + li {
    margin-top: var(--space-1);
  }

  .arrow-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-weight: 650;
  }

  .service-icon {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-3);
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-text);
    font-size: 1.1rem;
  }

  .stats {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-border);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
  }

  .stat dt {
    color: var(--color-muted);
  }

  .stat dd {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .closing p {
    margin: 0;
    max-width: 52ch;
    font-size: 1.15rem;
    color: var(--color-muted);
  }

  .closing strong {
    color: var(--color-text);
  }

  @media (min-width: 48rem) {
    .current {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-8);
      padding: var(--space-8);
    }

    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
