---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import jumpingPhoto from "../assets/images/milena-jumping.jpg";
import catsPhoto from "../assets/images/cats.jpg";
import mountainsPhoto from "../assets/images/mountains.jpg";
import coffeePhoto from "../assets/images/coffee.jpg";

const values = [
  {
    title: "Accessibility first",
    text: "Small, steady steps beat big audits. I help teams bake accessibility into components, reviews, and everyday habits.",
  },
  {
    title: "Design systems as a product",
    text: "Shared foundations that designers and engineers actually enjoy using — documented, tested, and built to scale.",
  },
  {
    title: "Community & mentoring",
    text: "Meetups shaped my career. I spent years organizing and speaking in them, and I still love being part of the community and sharing what I learn.",
  },
];

const funFacts = [
  {
    image: { src: catsPhoto, alt: "Two tabby cats sitting side by side on a teal sofa" },
    title: "Cat mom of two",
    text: "Two cats run my household and, if they had a say, my calendar too. They're my favourite reviewers: brutally honest and always ready to sit on the keyboard. They know many company secrets, and aren't afraid to share them.",
  },
  {
    image: {
      src: mountainsPhoto,
      alt: "Milena Suárez striking a playful leg-up pose on a stone terrace in front of green jungle mountains",
    },
    title: "Mountains & pole dance",
    text: "The mountains give me peace and fresh air. Pole dance gives me strength, confidence, and a lot of laughs (mostly at my own attempts!). Currently working toward nailing those basic moves, decent pole dancer in progress.",
  },
  {
    image: {
      src: coffeePhoto,
      alt: "Two milky coffees on a café table next to a basket of pandebono and almojábanas",
    },
    title: "Coffee & cheese bread",
    text: "A good Colombian coffee with a warm almojábana or pandebono is my idea of happiness. Cheesy, fresh from the oven, and a little taste of home wherever I am.",
  },
];
---

<BaseLayout title="About" description="About Milena Suárez — frontend engineer, design systems and accessibility advocate, and community member.">
  <section class="about-hero" aria-labelledby="about-title">
    <div class="photo-wrap">
      <Picture
        src={jumpingPhoto}
        formats={["avif", "webp"]}
        widths={[300, 600]}
        sizes="(min-width: 48rem) 12rem, min(18rem, 100vw)"
        alt="Milena Suárez jumping with arms wide open on a dirt road lined with baobab trees"
        class="photo"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div>
      <p class="eyebrow">About me</p>
      <h1 id="about-title">Hola, I'm Milena 👋</h1>
      <p class="lead">
        I'm a frontend engineer from Bogotá, Colombia, with 10+ years of experience. Today I work on
        design systems and accessibility at Babbel in Berlin. I care about interfaces that work for everyone, and about the people and
        teams who build them.
      </p>
      <p class="lead">
        I was organizing BogotaJS, co-organizing JSConf Colombia and
        Rails Girls Bogotá, and speaking at GDG Bogotá and Women Techmakers. Community is where I
        learned the most, and I'm still happy to be part of it.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="about-values">
    <div class="section-head">
      <p class="eyebrow">What drives me</p>
      <h2 id="about-values">What I care about</h2>
    </div>
    <div class="cards cards-3">
      {
        values.map((value) => (
          <article class="card">
            <h3>{value.title}</h3>
            <p>{value.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="about-facts">
    <div class="section-head">
      <p class="eyebrow">Beyond the code</p>
      <h2 id="about-facts">Fun facts about me</h2>
    </div>
    <div class="cards cards-3">
      {
        funFacts.map((fact) => (
          <article class="card fact-card">
            <Picture
              src={fact.image.src}
              formats={["avif", "webp"]}
              widths={[400, 600, 800]}
              sizes="(min-width: 60rem) min(23.5rem, calc(33vw - 1rem)), (min-width: 42rem) calc(50vw - 1.5rem), calc(100vw - 2rem)"
              alt={fact.image.alt}
              class="fact-photo"
            />
            <h3>{fact.title}</h3>
            <p>{fact.text}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .about-hero h1 {
    margin: 0.3rem 0 0;
    font-size: var(--font-size-h1);
  }

  .lead {
    margin: var(--space-4) 0 0;
    max-width: 60ch;
    color: var(--color-muted);
    font-size: 1.1rem;
  }
  .photo-wrap {
    position: relative;
    justify-self: center;
    width: min(18rem, 100%);
    aspect-ratio: 3 / 4;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    border-radius: var(--radius-lg);
  }

  /* Clip the edge-to-edge photo to the card's rounded corners. */
  .fact-card {
    overflow: hidden;
  }

  /* Cancel the card padding so the photo reaches the card borders. */
  .fact-photo {
    display: block;
    width: calc(100% + 2 * var(--space-5));
    max-width: none;
    height: auto;
    aspect-ratio: 4 / 3;
    margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) var(--space-4);
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .about-hero {
      /* Size the text column to the 60ch paragraphs and center both columns. */
      grid-template-columns: 12rem minmax(0, 60ch);
      justify-content: center;
      align-items: stretch;
      gap: var(--space-8);
    }

    /* Match the photo's height to the text column next to it. */
    .photo-wrap {
      width: 100%;
      aspect-ratio: auto;
    }
  }
</style>
