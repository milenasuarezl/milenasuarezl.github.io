---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Speaking">
  <section class="page-intro" aria-labelledby="speaking-title">
    <h1 id="speaking-title">Speaking</h1>
    <p>Conferences, meetups, and workshops where I share practical learnings.</p>
  </section>

  <section aria-labelledby="speaking-events">
    <h2 id="speaking-events">Recent sessions</h2>
    <div class="cards">
      <article class="card">
        <h3>Accessible by Default</h3>
        <p>Patterns for embedding accessibility into team workflows.</p>
      </article>
      <article class="card">
        <h3>Fast Frontend in Practice</h3>
        <p>Real-world strategies to improve metrics and user satisfaction.</p>
      </article>
    </div>
  </section>
</BaseLayout>
