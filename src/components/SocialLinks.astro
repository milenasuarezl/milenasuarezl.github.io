---
import styles from "./SocialLinks.module.css";
import { siteConfig } from "../data/site";
---

<ul class={styles.socialList}>
  <li>
    <a href={siteConfig.social.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn profile (opens in a new tab)">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4.98 3.5a2.49 2.49 0 1 0 0 4.98 2.49 2.49 0 0 0 0-4.98ZM3 9h4v12H3V9Zm7 0h3.83v1.71h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.54c0-1.32-.02-3.03-1.85-3.03-1.86 0-2.15 1.45-2.15 2.94V21h-4V9Z" />
      </svg>
      <span class="sr-only">LinkedIn</span>
    </a>
  </li>
  <li>
    <a href={siteConfig.social.github} target="_blank" rel="noreferrer" aria-label="GitHub profile (opens in a new tab)">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.11.79-.25.79-.56v-2.16c-3.2.7-3.88-1.35-3.88-1.35-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.74 2.68 1.24 3.34.95.1-.75.4-1.24.73-1.53-2.56-.29-5.26-1.28-5.26-5.72 0-1.27.45-2.3 1.18-3.12-.12-.29-.51-1.46.11-3.03 0 0 .97-.31 3.18 1.19a11 11 0 0 1 5.8 0c2.21-1.5 3.18-1.19 3.18-1.19.62 1.57.23 2.74.11 3.03.73.82 1.18 1.85 1.18 3.12 0 4.45-2.7 5.42-5.28 5.71.41.35.78 1.03.78 2.08v3.08c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
      </svg>
      <span class="sr-only">GitHub</span>
    </a>
  </li>
</ul>
